# The canonical public address of the deployed site. Used for canonical URLs,
# Open Graph tags, robots.txt and the sitemap. Never leave this as localhost in
# production, and do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=https://usagwp.com

# MongoDB connection string. The database stores all CMS content AND every
# uploaded image, because serverless hosts have no persistent filesystem.
MONGODB_URI=' your link'

# Signing key for the admin session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-of-at-least-32-characters

# SMTP for the two notification emails the site sends: a new contact form
# submission and a new story subscriber. Leave these unset and both forms keep
# working exactly as before — the record is still saved and shown in the admin,
# and the skipped email is logged server-side.
#
# Server-only. Never prefix any of these with NEXT_PUBLIC_.
SMTP_HOST=
# 465 for implicit TLS, 587 for STARTTLS. Defaults to 587.
SMTP_PORT=587
SMTP_USER=
# For Gmail/Workspace this is a 16-character App Password, not the account
# password. Put the real value in .env.local, which git ignores.
SMTP_PASSWORD=
# The From address. Defaults to SMTP_USER when empty.
SMTP_FROM=
# Where notifications are delivered. Defaults to SMTP_USER when empty.
CONTACT_EMAIL=
